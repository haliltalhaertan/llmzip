  "gate_claim": "Every load-bearing concept has one enumerated normative source; every occurrence of its value elsewhere is a declared typed mirror; no superseded literal survives anywhere; and no value-shaped token exists in the closure that no concept claims. Matching runs on normalised text (whitespace removed, case folded) so line wrapping and uppercase hex cannot hide a literal. Tokens that are not normative values are not silently ignored: each exempt class is declared here with its files, its key-path or allowlist scope, and a rationale, so an auditor can see exactly what the sweep chose not to hold to account and why.",
  "non_normative_token_classes": [
    {
      "class": "inventory_self_hashes",
      "files": [
        "PAYLOAD_HASHES.json"
      ],
      "json_key_prefixes": [
        "files[]"
      ],
      "rationale": "The inventory's own file digests are computed from the package, not asserted about anything else. They are self-describing and permitted only inside PAYLOAD_HASHES.json; scoping by key path means a normative literal placed anywhere else in this file is still caught."
    },
    {
      "class": "historical_provenance",
      "files": [
        "CANDIDATE_EXECUTION_SEAL.json"
      ],
      "json_key_prefixes": [
        "supersedes_candidate",
        "triggering_audit",
        "triggering_review",
        "payload_inventory"
      ],
      "rationale": "References to past artifacts - superseded candidates, the audits and co-chair reviews that produced this one, and the inventory binding. They record what happened; they impose no requirement on this package. Scoped to these key paths only."
    },
    {
      "class": "artifact_identifiers",
      "files": [
