-def surface(exc):
-    if exc is None:
-        return ""
-    parts, seen, pending = [], set(), [exc]
-    while pending:
-        node = pending.pop()
-        if id(node) in seen:
-            continue
-        seen.add(id(node))
-        parts.extend((str(node), repr(node)))
-        pending.extend(x for x in (node.__cause__, node.__context__) if x is not None)
-    return "\n".join(parts)
